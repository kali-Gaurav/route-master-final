{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  
  "env": {
    "PYTHON_VERSION": "3.12"
  },
  
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  
  "regions": ["iad1"]
}
