# Railway Operating System - Environment Configuration
# Copy this file to .env and update values for your environment

# ===============================================
# APPLICATION SETTINGS
# ===============================================

ENVIRONMENT=development
DEBUG_MODE=true
LOG_LEVEL=INFO

# ===============================================
# SERVICE PORTS
# ===============================================

API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
ROUTE_SERVICE_PORT=8002
DATA_SERVICE_PORT=8003
WORKER_SERVICE_PORT=8004

# ===============================================
# SERVICE URLs
# ===============================================

API_GATEWAY_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001
ROUTE_SERVICE_URL=http://localhost:8002
DATA_SERVICE_URL=http://localhost:8003
WORKER_SERVICE_URL=http://localhost:8004

# ===============================================
# DATABASE CONFIGURATION
# ===============================================

DATABASE_URL=postgresql://railway_user:railway_password@localhost:5432/railway_os
DB_USER=railway_user
DB_PASSWORD=railway_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ===============================================
# REDIS CONFIGURATION
# ===============================================

REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_TTL=3600

# ===============================================
# RABBITMQ CONFIGURATION
# ===============================================

RABBITMQ_URL=amqp://railway_user:railway_password@localhost:5672/
RABBITMQ_USER=railway_user
RABBITMQ_PASSWORD=railway_password
RABBITMQ_EXCHANGE=railway_os
RABBITMQ_QUEUE=route_jobs

# ===============================================
# ROUTE SEARCH CONFIGURATION
# ===============================================

MAX_TRANSFERS=3
DEFAULT_PAGE_SIZE=10
MAX_ROUTE_RESULTS=100
ROUTE_CACHE_TTL=3600
MIN_TRANSFER_TIME=30

# ===============================================
# AUTHENTICATION & SECURITY
# ===============================================

DEFAULT_RATE_LIMIT_MINUTE=1000
DEFAULT_RATE_LIMIT_HOUR=10000
TOKEN_EXPIRY_DAYS=365
API_KEY_HEADER=Authorization
API_KEY_PREFIX=Bearer

# ===============================================
# CORS CONFIGURATION
# ===============================================

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ===============================================
# JOB PROCESSING CONFIGURATION
# ===============================================

JOB_MAX_RETRIES=3
JOB_RETRY_DELAY=60
JOB_TIMEOUT=300
JOB_CONCURRENCY=4

# ===============================================
# MONITORING & LOGGING
# ===============================================

METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
LOG_FORMAT=json
ENABLE_AUDIT_LOG=true

# ===============================================
# DEVELOPMENT SETTINGS
# ===============================================

# Database for testing (separate from development)
TEST_DATABASE_URL=postgresql://railway_user:railway_password@localhost:5432/railway_os_test

# Enable SQL query logging in development
SQL_ECHO=false

# ===============================================
# PRODUCTION OVERRIDES
# ===============================================
# These values will override the above when ENVIRONMENT=production

# Production Database
# DATABASE_URL=postgresql://prod_user:prod_password@prod-db-host:5432/railway_os_prod
# DB_USER=prod_user
# DB_PASSWORD=prod_password

# Production Redis
# REDIS_URL=redis://prod-redis-host:6379

# Production RabbitMQ
# RABBITMQ_URL=amqp://prod_user:prod_password@prod-rabbitmq-host:5672/
# RABBITMQ_USER=prod_user
# RABBITMQ_PASSWORD=prod_password

# Production CORS
# CORS_ORIGINS=https://app.railwayos.com,https://api.railwayos.com

# ===============================================
# EXTERNAL SERVICE INTEGRATIONS
# ===============================================

# Email service (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Monitoring service (Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# CDN for static assets
# CDN_URL=https://cdn.railwayos.com

# ===============================================
# FEATURE FLAGS
# ===============================================

# Enable experimental features
ENABLE_EXPERIMENTAL_ROUTES=false
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_REAL_TIME_UPDATES=false

# ===============================================
# BACKUP CONFIGURATION
# ===============================================

# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ===============================================
# SECURITY SETTINGS
# ===============================================

# Encryption keys (generate strong random keys)
ENCRYPTION_KEY=your-256-bit-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# SSL/TLS settings
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# ===============================================
# PERFORMANCE TUNING
# ===============================================

# Connection pool settings
MAX_CONNECTIONS_PER_WORKER=10
CONNECTION_POOL_TIMEOUT=30

# Cache settings
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=512

# ===============================================
# THIRD-PARTY API KEYS
# ===============================================

# For external integrations (weather, traffic, etc.)
# WEATHER_API_KEY=your-weather-api-key
# TRAFFIC_API_KEY=your-traffic-api-key
# GEOCODING_API_KEY=your-geocoding-api-key