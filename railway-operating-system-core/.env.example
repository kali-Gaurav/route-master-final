# =========================================================
# Environment Configuration Template
# Copy this to .env and update values for your environment
# =========================================================

# ========================
# Application Environment
# ========================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ========================
# Database Configuration
# ========================
POSTGRES_DB=railway_db
POSTGRES_USER=railway_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_PORT=5432

# Database URL (constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ========================
# Redis Configuration
# ========================
REDIS_PASSWORD=change_this_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ========================
# Security Keys
# ========================
# Generate secure keys using: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret-use-openssl-rand-hex-32
CSRF_SECRET_KEY=change-this-csrf-secret-use-openssl-rand-hex-32
SECRET_KEY=change-this-secret-key-use-openssl-rand-hex-32

# ========================
# API Configuration
# ========================
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# API URL for frontend
VITE_API_URL=http://localhost:8000

# ========================
# Application Settings
# ========================
# Number of API workers (recommend: 2 * CPU cores + 1)
WORKERS=4

# Maximum routes to search
MAX_ROUTES=100

# Maximum transfer allowed
MAX_TRANSFERS=3

# ========================
# Feature Flags
# ========================
ENABLE_MONITORING=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true

# ========================
# Monitoring & Observability
# ========================
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090

ENABLE_GRAFANA=false
GRAFANA_PORT=3001

# ========================
# Development Settings
# ========================
# Only for development environment
DEV_MODE=false
HOT_RELOAD=false
